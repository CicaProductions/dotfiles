# The directory for your scripts
PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

# Set up the AeroSpace workspaces module
sketchybar --add item workspaces left \
  --set workspaces script="$PLUGIN_DIR/aerospace_workspaces.sh" \
  update_freq=1

# The directory for your scripts
PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Some items refresh on a fixed cycle, e.g. the clock runs its script once
# every 10s. Other items respond to events they subscribe to, e.g. the
# volume.sh script is only executed once an actual change in system audio
# volume is registered. More info about the event system can be found here:
# https://felixkratz.github.io/SketchyBar/config/events

sketchybar --add item clock right \
           --set clock update_freq=1 icon=  script="$PLUGIN_DIR/clock.sh" \
           --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=10 script="$PLUGIN_DIR/battery.sh" \
           --set icon.drawing=on \
           --subscribe battery system_woke power_source_change

# Add a reload button to the bar
sketchybar --add item reload right \
  --set reload icon="" \
  icon.padding_left=10 \
  icon.padding_right=10 \
  label.drawing=off \
  click_script="$PLUGIN_DIR/reload_all.sh"

# Add the main Bluetooth item
sketchybar --add item bluetooth right \
  --set bluetooth update_freq=10 \
  script="$PLUGIN_DIR/bluetooth.sh" \
  click_script="sketchybar --set bluetooth.popup drawing=toggle" \
  popup.align=right \
  popup.background.color=0xff282c34 \
  popup.border_width=2 \
  popup.border_color=0xffc678dd \
  popup.y_offset=20 \
  popup.label.font="FiraCode Nerd Font:Regular:12" \
  --subscribe bluetooth mouse.entered

# Add the popup items (this is the key part)
sketchybar --add item bluetooth.popup popup.bluetooth \
  --set bluetooth.popup drawing=off \
  script="blueutil --paired --format json | jq -r '
  .[] | \"--add item bluetooth.popup.\(.name) popup.bluetooth --set bluetooth.popup.\(.name) label=\(.name) click_script=\\\"blueutil --pair \(.address)\\\"\"' | xargs sketchybar"

##### Force all scripts to run the first time (never do this in a script) #####
sketchybar --update
